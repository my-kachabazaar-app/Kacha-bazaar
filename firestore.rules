rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc(u) { return get(/databases/$(database)/documents/users/$(u)).data; }
    function walletDebitOk() {
      let oid = request.resource.data.get('walletOrder', '');
      let o = getAfter(/databases/$(database)/documents/orders/$(oid)).data;
      return oid != '' && o.uid == request.auth.uid && o.pay == 'wallet'
        && request.resource.data.wallet >= 0
        && request.resource.data.wallet == resource.data.get('wallet', 0) - o.walletUsed;
    }
    function verified() { return request.auth.token.email_verified == true || ('phone_number' in request.auth.token); }
    function isAdmin() { return signedIn() && userDoc(request.auth.uid).role == 'admin' && userDoc(request.auth.uid).get('approved', true) == true; }
    function riderCap() {
      let p = /databases/$(database)/documents/settings/rider;
      return exists(p) ? get(p).data.get('maxEarn', 1000) : 1000;
    }
    function callOk(oid, who, callee) {
      let o = get(/databases/$(database)/documents/orders/$(oid)).data;
      return who == 'rider'
        ? (o.riderId == request.auth.uid && o.uid == callee && !(o.status in ['delivered', 'cancelled']))
        : (o.uid == request.auth.uid && o.riderId == callee
            && (!(o.status in ['delivered', 'cancelled'])
              || request.time < (o.status == 'delivered' ? o.deliveredAt : o.cancelledAt) + duration.value(1, 'h')));
    }

    match /users/{u} {
      allow delete: if signedIn() && request.auth.uid == u;
      allow read: if signedIn() && (request.auth.uid == u || isAdmin());
      allow create: if signedIn() && request.auth.uid == u
        && (request.resource.data.role == 'customer'
          || (request.resource.data.role == 'rider' && request.resource.data.get('approved', false) == false));
      allow update: if isAdmin() || (signedIn() && request.auth.uid == u
        && request.resource.data.role == resource.data.role
        && request.resource.data.get('riderCode', '') == resource.data.get('riderCode', '')
        && request.resource.data.get('approved', false) == resource.data.get('approved', false)
        && (request.resource.data.get('wallet', 0) == resource.data.get('wallet', 0) || walletDebitOk())
        && request.resource.data.get('blocked', false) == resource.data.get('blocked', false)
        && request.resource.data.get('status', 'active') == resource.data.get('status', 'active')
        && request.resource.data.get('adminRole', '') == resource.data.get('adminRole', '')
        && request.resource.data.get('pay', {}) == resource.data.get('pay', {})
        && request.resource.data.get('docVerified', {}) == resource.data.get('docVerified', {})
        && request.resource.data.get('rateCard', '') == resource.data.get('rateCard', '')
        && (resource.data.get('approved', false) == false || request.resource.data.get('storeId', '') == resource.data.get('storeId', '')));
    }
    match /users/{u}/kyc/{t} {
      allow read: if signedIn() && (request.auth.uid == u || isAdmin());
      allow write: if signedIn() && request.auth.uid == u && !userDoc(u).get('approved', false);
    }
    match /users/{u}/wallet/{t} {
      allow read: if signedIn() && (request.auth.uid == u || isAdmin());
      allow create: if isAdmin() || (signedIn() && request.auth.uid == u && request.resource.data.type == 'debit'
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.walletUsed == -request.resource.data.amt);
      allow update, delete: if isAdmin();
    }
    match /lookup/{k} {
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow get: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && (k == request.auth.token.email || k == userDoc(request.auth.uid).phone || k == 'r_' + userDoc(request.auth.uid).phone);
    }
    match /products/{p} { allow read: if true; allow write: if isAdmin(); }
    match /categories/{c} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{k} { allow read: if true; allow write: if isAdmin(); }
    match /homeBanners/{b} { allow read: if true; allow write: if isAdmin(); }
    match /stores/{s} { allow read: if true; allow write: if isAdmin(); }
    match /coupons/{c} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /riderMedia/{m} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /files/{f} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /counters/{c} { allow read, write: if isAdmin(); }
    match /payouts/{p} {
      allow read: if signedIn() && (isAdmin() || resource.data.riderId == request.auth.uid);
      allow write: if isAdmin();
    }
    match /payslips/{p} {
      allow read: if signedIn() && (isAdmin() || resource.data.riderId == request.auth.uid);
      allow write: if isAdmin();
    }
    match /deposits/{d} {
      allow read: if signedIn() && (isAdmin() || resource.data.riderId == request.auth.uid);
      allow create: if isAdmin() || (signedIn() && request.resource.data.riderId == request.auth.uid
        && request.resource.data.status == 'pending' && request.resource.data.amount > 0);
      allow update: if isAdmin();
    }
    match /tickets/{t} {
      allow create: if signedIn() && request.resource.data.riderId == request.auth.uid
        && request.resource.data.status == 'open' && request.resource.data.msgs.size() == 1;
      allow read: if signedIn() && (isAdmin() || resource.data.riderId == request.auth.uid);
      allow update: if isAdmin() || (signedIn() && resource.data.riderId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['msgs', 'status'])
        && request.resource.data.status == 'open'
        && request.resource.data.msgs.size() == resource.data.msgs.size() + 1);
    }
    match /tokens/{t} {
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == userDoc(request.auth.uid).role;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /broadcasts/{b} { allow create, read: if isAdmin(); }
    match /calls/{c} {
      allow create: if signedIn() && request.resource.data.callerUid == request.auth.uid
        && callOk(request.resource.data.orderId, request.resource.data.caller, request.resource.data.calleeUid);
      allow read, update, delete: if signedIn() && (resource.data.callerUid == request.auth.uid || resource.data.calleeUid == request.auth.uid);
      match /ice/{i} {
        allow create, read, delete: if signedIn() && (get(/databases/$(database)/documents/calls/$(c)).data.callerUid == request.auth.uid
          || get(/databases/$(database)/documents/calls/$(c)).data.calleeUid == request.auth.uid);
      }
    }
    match /trails/{x} {
      allow read: if signedIn() && (isAdmin() || resource.data.riderId == request.auth.uid
        || get(/databases/$(database)/documents/orders/$(x)).data.uid == request.auth.uid);
      allow create, update: if signedIn() && request.resource.data.riderId == request.auth.uid;
      allow delete: if isAdmin();
    }
    match /orders/{o} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.riderId == null
        && !userDoc(request.auth.uid).get('blocked', false)
        && (request.resource.data.get('pay', '') != 'wallet' || userDoc(request.auth.uid).get('wallet', 0) >= request.resource.data.get('walletUsed', 0));
      allow read: if signedIn() && (isAdmin() || resource.data.uid == request.auth.uid
        || (resource.data.riderId == request.auth.uid && verified()));
      allow update: if isAdmin() || (signedIn() && resource.data.riderId == request.auth.uid
        && verified()
        && userDoc(request.auth.uid).get('status', 'active') == 'active'
        && !(resource.data.status in ['delivered', 'cancelled'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'collectedAt', 'arrivedAt', 'deliveredAt', 'cancelledAt', 'cancelReason', 'earn', 'finalTotal', 'flags', 'returnPending'])
        && request.resource.data.status in ['collected', 'arrived', 'delivered', 'cancelled']
        && (request.resource.data.status != 'delivered'
          || (request.resource.data.earn >= 0 && request.resource.data.earn <= riderCap() && request.resource.data.deliveredAt == request.time)));
    }
  }
}
